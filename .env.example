# Copy to server/.env and fill in before deploying.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vanilla-smiles

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# First admin account — bootstrapped by `npm run seed`. Powers only; change the
# password on first login (the panel forces it).
ADMIN_EMAIL=admin@vanillasmiles.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: run the idempotent bootstrap on every server start (dev convenience).
AUTO_SEED=false

# Upload limits (images are stored on local disk under server/uploads).
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES=10
